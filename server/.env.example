# SQLite file DB (path is relative to server/prisma/schema.prisma).
# To switch to Postgres: set provider = "postgresql" in schema.prisma and use
# DATABASE_URL="postgresql://user:pass@localhost:5432/relay"
DATABASE_URL="file:./dev.db"

# Change this in any real deployment!
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

API_PORT=4000
# Origin of the frontend (used for CORS when not going through the Vite proxy)
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development
